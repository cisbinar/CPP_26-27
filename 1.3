#include <iostream>
#include <cstring>

const int row = 5;
const int col = 10;

void clear(char b[row][col]) {
  for (int y = 0; y < row; ++y) {
    for (int x = 0; x < col; ++x) {
      b[y][x] = ' ';
    }
  }
}

bool put(char b[row][col], int x, int y, char c) {
  if (x < 0 || x >= col || y < 0 || y >= row) {
    return false;
  }
  b[y][x] = c;
  return true;
}

bool text(char b[row][col], int x, int y, const char* word) {
  int len = static_cast<int>(std::strlen(word));
  if (y < 0 || y >= row || x < 0 || x + len > col) {
    return false;
  }
  for (int i = 0; i < len; ++i) {
    b[y][x + i] = word[i];
  }
  return true;
}

void print(const char b[row][col]) {
  for (int y = 0; y < row; ++y) {
    for (int x = 0; x < col; ++x) {
      std::cout << b[y][x];
    }
    std::cout << '\n';
  }
}

int main() {
  char b[row][col];
  clear(b);

  char cmd[32];
  while (true) {
    std::cin >> cmd;
    if (std::strcmp(cmd, "quit") == 0) {
      break;
    }

    if (std::strcmp(cmd, "clear") == 0) {
      clear(b);
    } else if (std::strcmp(cmd, "put") == 0) {
      int x, y;
      char c;
      std::cin >> x >> y >> c;
      if (!put(b, x, y, c)) {
        std::cout << "error\n";
      }
    } else if (std::strcmp(cmd, "text") == 0) {
      int x, y;
      char word[16];
      std::cin >> x >> y >> word;
      if (!text(b, x, y, word)) {
        std::cout << "error\n";
      }
    } else if (std::strcmp(cmd, "print") == 0) {
      print(b);
    } else {
      std::cout << "error\n";
    }
  }

  return 0;
}
