#include <iostream>
#include <cstring>

using OpFunc = void (*)(int&, int);

void dep(int& balance, int k) {
  if (k <= 0) {
    std::cout << "error\n";
    return;
  }
  balance += k;
}

void draw(int& balance, int k) {
  if (k <= 0 || k > balance) {
    std::cout << "error\n";
    return;
  }
  balance -= k;
}

void showbalance(int& balance, int) {
  std::cout << balance << '\n';
}

void reset(int& balance, int) {
  balance = 0;
}

void doub(int& balance, int) {
  balance *= 2;
}

int main() {
  const char* name[] = {"deposit", "withdraw", "balance", "reset", "double"};
  OpFunc fn[] = {dep, draw, showbalance, reset, doub};
  const int cnt = 5;

  int balance = 0;
  char cmd[32];

  while (true) {
    std::cin >> cmd;
    if (std::strcmp(cmd, "stop") == 0) {
      break;
    }

    int k = 0;
    if (std::strcmp(cmd, "deposit") == 0 || std::strcmp(cmd, "withdraw") == 0) {
      std::cin >> k;
    }

    bool flag = false;
    for (int i = 0; i < cnt; ++i) {
      if (std::strcmp(cmd, name[i]) == 0) {
        fn[i](balance, k);
        flag = true;
        break;
      }
    }
    if (!flag) {
      std::cout << "error\n";
    }
  }

  return 0;
}
